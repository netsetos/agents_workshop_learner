# Workstation/project configuration and Terraform state never belong in Git.
# IDE-run Python examples and imported kit modules create these locally.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/*.tfplan.checked.json
terraform/runbook-selected-plan.json
terraform/tfplan*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/*.tfvars*.bak
operator-evidence/

# One lab's state, never the repository's: a learner's clone stays clean after the make targets run.
.candidate-revision
.previous-revision
compare.csv
evals/reports/
services/slm/build/
evals/corpus/**/*.mp4
evals/corpus/**/*.mp3
evals/corpus/**/*.wav
evals/corpus/**/*.segments.json
